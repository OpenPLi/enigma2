#include <cctype>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <lib/base/eenv.h>
#include <lib/base/eerror.h>

bool eEnv::initialized = false;

void eEnv::initialize()
{
	static const struct {
		std::string name;
		std::string value;
	} cfgenv[] = {
		{ "prefix", "@prefix@" },
		{ "exec_prefix", "@exec_prefix@" },
		{ "bindir", "@bindir@" },
		{ "sbindir", "@sbindir@" },
		{ "libexecdir", "@libexecdir@" },
		{ "datarootdir", "@datarootdir@" },
		{ "datadir", "@datadir@" },
		{ "sysconfdir", "@sysconfdir@" },
		{ "sharedstatedir", "@sharedstatedir@" },
		{ "localstatedir", "@localstatedir@" },
		{ "libdir", "@libdir@" },
		{ "localedir", "@localedir@" },
	};
	size_t i;

	// 1st pass, as generated by configure.
	// Variables set by the user will not be overwritten.
	for (i = 0; i < (sizeof(cfgenv) / sizeof(*cfgenv)); i++) {
		setenv(cfgenv[i].name.c_str(), cfgenv[i].value.c_str(), 0);
	}

	// 2nd pass: Resolve directories.
	for (i = 0; i < (sizeof(cfgenv) / sizeof(*cfgenv)); i++) {
		std::string dest;
		eEnv::resolveVar(dest, "${" + cfgenv[i].name + "}");
		setenv(cfgenv[i].name.c_str(), dest.c_str(), 1);
	}
}

/*
 * Expand $name and ${name} from the environment, recursively.
 * This used wordexp(WRDE_NOCMD | WRDE_UNDEF), but musl rejects '{' and '}'
 * outside quotes with WRDE_BADCHAR, so every "${libdir}/..." came out empty
 * and enigma2 quit before running StartEnigma.py.
 */
int eEnv::resolveVar(std::string &dest, const char *src)
{
	std::string out;
	const char *s = src;

	while (*s) {
		if (*s != '$') {
			out += *s++;
			continue;
		}
		const char *start = s + 1;
		std::string name;
		if (*start == '{') {
			const char *end = strchr(start + 1, '}');
			if (!end) {
				eDebug("[eEnv] %s: syntax error in '%s'", __func__, src);
				return -1;
			}
			name.assign(start + 1, end - start - 1);
			s = end + 1;
		} else {
			const char *p = start;
			while (*p && (isalnum((unsigned char)*p) || *p == '_'))
				p++;
			if (p == start) {
				out += *s++;
				continue;
			}
			name.assign(start, p - start);
			s = p;
		}
		const char *val = getenv(name.c_str());
		if (!val) {
			eDebug("[eEnv] %s: undefined variable '%s'", __func__, name.c_str());
			return -1;
		}
		if (strchr(val, '$')) {
			std::string sub;
			if (eEnv::resolveVar(sub, val) < 0)
				return -1;
			out += sub;
		} else {
			out += val;
		}
	}

	dest.append(out);
	return 0;
}

int eEnv::resolveVar(std::string &dest, const std::string &src)
{
	return eEnv::resolveVar(dest, src.c_str());
}

std::string eEnv::resolve(const std::string &src)
{
	std::string dest;

	if (!initialized) {
		eEnv::initialize();
		initialized = true;
	}

	eEnv::resolveVar(dest, src);

	return dest;
}
